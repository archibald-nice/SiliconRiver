# Python
__pycache__/
*.py[cod]
*.sqlite3-journal

# Virtual environments
.venv/
.env
*/.env
.env.*
# 模板文件要能提交（`*/.env` 与 `.env.*` 都会命中它们）
!.env.example
!*/.env.example

# Data artefacts
/data/*
# 例外：这两份 yaml 是人工维护的**映射/来源清单**（代码级资产），不是抓取产物，必须进仓库
!/data/provider_logos.yaml
!/data/arena_aliases.yaml
*.db
# scripts/daily_sync.sh 的日志落盘目录，不应提交
logs/

# 内部文档：本地保留，但不进公开仓库（含历史，已用 git filter-repo 清除）
docs/

# 本地开发数据库数据目录（scripts/dev_db.sh 默认放 /tmp，
# 若用 SILICON_RIVER_PGDATA 指到仓库内则忽略掉）
.pgdata/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# TypeScript 构建产物（由 tsc -b 生成，不要提交）
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Vercel
.vercel/

# Builds / coverage
htmlcov/
.coverage
.pytest_cache/

# IDE / OS
.DS_Store
Thumbs.db

# Claude Code settings (local machine specific)
.claude/
