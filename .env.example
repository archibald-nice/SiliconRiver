# ============================================================
# Silicon River 环境变量模板
# 复制为 .env 后按下面注释填写：cp .env.example .env
# ============================================================

# ---------- 数据库（必填）----------
# Supabase 控制台 → Project Settings → Database → Connection string → Session pooler
# 用 5432 端口的 Session Pooler（支持预编译语句）；务必带 ?sslmode=require
# 密码中的特殊字符需要 URL 编码，例如 @ 写成 %40
DATABASE_URL=postgresql://postgres.你的项目ID:你的密码@aws-0-区域代码.pooler.supabase.com:5432/postgres?sslmode=require

# 数据库连接超时（秒）：库不可达时快速失败，不让请求挂到平台超时
DB_CONNECT_TIMEOUT=10

# ---------- 数据库连接池 ----------
# 进程级连接池，避免每个请求都重走 TCP + TLS + 认证。
# min_size=0：冷启动不抢连接，空闲时也不占 Supabase 的连接配额。
# max_size 压得小是刻意的：Supabase 免费层连接数有限，而 serverless 实例会横向
# 放大，池开大反而更容易打满上游配额。
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=4
# 空闲超过这么多秒就还给上游（Supabase 会掐掉长期空闲的连接）
DB_POOL_MAX_IDLE=300
# 池里无可用连接时最多等这么久，超时抛 PoolTimeout 而不是一直挂着
DB_POOL_TIMEOUT=10

# 语句级超时（毫秒）：单条 SQL 跑超这么久就被 PostgreSQL 掐断（SQLSTATE 57014），
# 避免慢查询长期占住池里的连接、把整个 API 拖到平台超时。
# 注意实现方式：连接池用 configure 回调对每条新连接执行 `SET statement_timeout`。
# 不用 conninfo 的 options="-c statement_timeout=…"——在 Supabase 上它会被角色/库级
# 设置覆盖，建连不报错但值静默不变（实测仍是角色的 2min），等于没配。
DB_STATEMENT_TIMEOUT_MS=5000

# ---------- CORS ----------
# 生产是 Vercel Services 同域部署，前端走相对路径 /api/*，不产生跨域请求，
# 所以默认只放行本地开发地址即可。分域部署时把前端域名加进来（逗号分隔）。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据源 ----------
# 需要抓取的 Hugging Face 组织（org 名，区分大小写照官网写），逗号分隔。
# 名单口径见 docs/issues/031：只收「自己发模型」的 org；bartowski / lmstudio-community /
# mlx-community / MaziyarPanahi / unsloth 这类量化搬运号、trl-internal-testing 这类测试号、
# facebook 这类基本不发 LLM 的 org 都不收。
PROVIDERS=meta-llama,google,microsoft,openai,01-ai,deepseek-ai,Qwen,mistralai,baichuan-inc,zai-org,tencent,allenai,EleutherAI,ibm-granite,LGAI-EXAONE,LiquidAI,moonshotai,NousResearch,nvidia,openbmb,XiaomiMiMo,z-lab
# OpenRouter 的厂商**白名单过滤器**（留空 = 不过滤，全收）。
#
# 匹配用的 provider key 由 provider_key_for() 解析，回落顺序（ISSUE-032）：
#   ① model_id 斜杠前缀，**仅当它登记在 PROVIDER_KEY_ALIASES 里**（品牌别名，见下）
#   ② name 字段的展示名（冒号前的部分）—— 白名单主要按这个口径收录
#   ③ 未经别名映射的 id 前缀（qwen、gryphe、anthracite-org、rekaai 这类前缀本身即条目）
#   ④ name 整串小写（兜底）
# 已登记的品牌别名（id 前缀 → provider key，不要在这里重复配置）：
#        mistralai  -> mistral      z-ai      -> z.ai
#        meta-llama -> meta         x-ai/xai  -> spacexai
#        liquidai 系、aion-labs、bytedance-seed、ibm-granite、inference-net、
#        nex-agi、NousResearch、prism-ml、thinkingmachines、arcee-ai 等同理。
#    代码逻辑：provider_key_for(item) in providers_filter（在 select_models() 里，
#    发生在 limit 截断**之前**，见 ISSUE-030）。
#    白名单里某个条目一条都没匹配到时**会打 WARNING**（列出该条目），不再是静默消失；
#    看到这个告警就说明该条目的写法与上游展示名 / id 前缀都没对上。
PROVIDERS_OPENROUTER=aionlabs,amazon,anthracite-org,anthropic,arcee ai,bytedance,bytedance seed,cohere,deepseek,fireworks,google,gryphe,ibm,inception,inclusionai,inference.net,liquidai,mancer,meituan,meta,microsoft,minimax,mistral,moonshotai,morph,nex agi,nous,nvidia,openai,perceptron,perplexity,poolside,prismml,qwen,rekaai,relace,sakana,sao10k,scaledown,spacexai,stepfun,tencent,thedrummer,thinking machines,typesafe,undi95,upstage,venice,writer,xiaomi,z.ai
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
# Hugging Face 令牌。
# 不填也能抓模型元数据（列表接口是公开的），但**拿不到 gated 仓库的 README**：
# meta-llama 全部是 gated（README 返回 401 Access restricted），不配 token 时
# 这个厂商的模型简介会全空（实测约占全库 10%）。
# 要用 token 读 gated 仓库，还得先在网页上接受该仓库的许可条款。
HF_TOKEN=
# 每家组织每次抓取的模型上限；0 = 不限（推荐）。
# 窗口用满时会打 WARNING「抓取窗口已用满，大概率还有模型被截断」——新增的大 org
# 动辄 200+ 个模型，上限 200 会让「官网有、时间轴没有」变成静默故障（ISSUE-031）。
HF_DAILY_FETCH_LIMIT=0
# 抓 HF 时按 pipeline_tag 过滤；留空 = 不过滤。
# 默认开 text-generation：不带 filter 时 HF 会把该 org 的全部仓库拉回来
# （实测 nvidia 975 个仓库里只有 269 个是 text-generation），视觉/语音仓库会污染时间轴。
HF_PIPELINE_TAG=text-generation
# 批量写（ISSUE-034）：默认开启。生产实测 200 个模型从 219 秒降到 3.7 秒
# （逐行写是 1.1 秒/模型，批量写约 19 毫秒/模型，主要成本变成网络拉取）。
# 出问题时的逃生门：设成 0 立刻退回逐行写（语义完全一致，只是慢）。
SCRAPER_BATCH_WRITE=1
# 每批条数。1000 行一条语句实测 1.67 秒；调小只是多几次往返。
SCRAPER_BATCH_SIZE=1000
# ⚠️ OpenRouter 的这个 limit 现在作用于**白名单过滤之后**（ISSUE-030 已把顺序
#    改成「先在 select_models() 里按 PROVIDERS_OPENROUTER 过滤，再按 limit 截断」）：
#        matched  = [m for m in raw_models if provider_key_for(m) in providers_filter]
#        selected = matched[:limit]   # 只有「命中白名单的条数 > limit」才截断
#    语义：limit 是「拿到足够多已过滤结果就停」的安全阀，**不再用来丢弃源数据**。
#    真的发生截断时一定打 WARNING，内容形如：
#        「上游 N 条，白名单命中 F 条，窗口 M 条，丢弃 K 条白名单模型」
#    推荐值 **0（= 不截断）**：上游再增长也不会重新踩坑；
#    确实需要限流时留足余量，建议 **600**（2026-10-18 实测上游 471 条、白名单命中 445 条）。
#    历史坑：旧实现先截断再过滤，limit=462 < 上游 471 时 mancer 等尾部厂商静默消失。
OPENROUTER_DAILY_FETCH_LIMIT=0

# ---------- 模型简介（README 拉取）----------
# HF 已经把模型描述从卡片元数据里移除了（cardData 恒为 null，ModelCardData 没有
# summary 字段），简介只能从仓库 README.md 正文里抽 —— 每个模型一次 HTTP 请求。
# 关掉能让抓取快很多，代价是 models.description 一直是空的：
# 前端焦点气泡少一行描述、按描述搜索失效、AI 分析少一块输入。
FETCH_DESCRIPTIONS=true
# 并发拉取 README 的线程数
DESCRIPTION_CONCURRENCY=8
DESCRIPTION_TIMEOUT=10
# 简介截断长度（与数据库 description 字段保持一致）
DESCRIPTION_MAX_CHARS=300

# ---------- 前端访问后端的基址 ----------
# ⚠️ 注意：Vite 的 envDir 是 frontend/，所以**本文件里的 VITE_* 不影响前端构建**。
#    实测确认过：把 VITE_API_BASE 写在这里，产物里不会出现该值。
#    前端相关的 VITE_* 请写到 frontend/.env（模板见 frontend/.env.example）。
#    下面两行仅保留给「用 shell 导出环境变量」的用法，例如：
#        VITE_API_TARGET=http://localhost:8000 npm run dev
VITE_API_BASE=
VITE_API_TARGET=http://localhost:8000

# ---------- AI 分析（可选）----------
# 不填则跳过 AI 分析步骤，只导入模型基础数据（不影响前端展示）
DEEPSEEK_API_KEY=
# ⚠️ 必须填 **base_url**，不要带 /chat/completions。
# SDK 会自己在后面拼 /chat/completions，填了完整端点会导致**每个模型都 404**。
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 是否在抓取流程末尾顺带跑分析。
# 注意：抓取脚本里两个增量任务**各自**都会调一次，所以开着等于每天跑两遍分析；
# 而且分析失败在那里被 try/except 吞掉、退出码仍是 0，监控看不到。
# 推荐拆成两个定时任务——同步用 daily_sync.sh（它会把这项强制设为 false），
# 分析单独跑 `python -m src.scraper.analysis_orchestrator`。
ENABLE_POST_SCRAPE_ANALYSIS=false

# ---------- Brave Search（可选）----------
BRAVE_SEARCH_API_KEY=
# 没配 API Key 时建议改成 false，避免每次都发无效请求
ENABLE_BRAVE_SEARCH=false
BRAVE_SEARCH_TIMEOUT=10
BRAVE_SEARCH_MAX_RETRIES=3

# ---------- 抓取与分析行为 ----------
HTTP_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2
LOG_LEVEL=INFO
ANALYSIS_LIMIT_PER_PROVIDER=500
# 分析入口（python -m src.scraper.analysis_orchestrator）的退出码判定：
# 失败率超过该比例，或本批**全部**失败，就以非 0 退出，供 systemd OnFailure /
# 监控脚本捕获。个例失败是常态（有的模型 README 抽不出正文），所以不能一失败就报。
ANALYSIS_MAX_FAILURE_RATE=0.2
ENABLE_MCP_SEARCH=true
ENABLE_MCP_ARXIV=false
MAX_CONCURRENT_ANALYSIS=5
ANALYSIS_TIMEOUT_SECONDS=30
# 每批提交给分析器的模型数，以及批次之间的间隔（秒）。
# 主要用于对上游限流友好：批太大 + 无间隔容易触发 DeepSeek 的速率限制。
ANALYSIS_BATCH_SIZE=10
ANALYSIS_DELAY_BETWEEN_BATCHES=2.0
# 分析时是否在线抓取 SWE-bench / LMSYS / HF 排行榜排名。
# 默认 false：那三个上游一个 404、一个 20s 超时，合计约 70s，远超单模型的
# 30s 预算，会把 LLM 调用直接挤掉；且失败后回落到写死的假排名，污染分析结论。
# 真排行榜数据请用 scripts/update_arena_scores.py 单独同步。
ENABLE_LEADERBOARD_LOOKUP=false

# ---------- 提供商头像 ----------
# 头像首次访问后会把二进制缓存进 providers.avatar_blob，之后直接吐缓存。
# 下面几项只影响「缓存未命中时的上游回退」这条路径。
# 回退抓取时的大小上限（字节）。超过则本次只回传、不落缓存（避免把大图写进库）。
AVATAR_MAX_BYTES=524288
# 回退抓取的超时（秒）
AVATAR_FETCH_TIMEOUT=6
# 浏览器缓存时长（秒），默认 1 天
AVATAR_CACHE_TTL=86400
# 允许抓取的主机白名单（逗号分隔），SSRF 防线。
# avatar_url 是抓取脚本写进库的值，接口侧按它代服务端发请求；不设白名单就等于
# 「能写 providers 表 → 能让服务端请求任意地址」（含内网/云元数据端点）。
# 匹配规则：主机等于列表项，或是它的子域（huggingface.co 覆盖
# cdn-avatars.huggingface.co），且只放行 http/https + 80/443 端口。
# 默认值来自线上 providers 表的实际主机（HF 抓取写入的 avatarUrl / og:image）。
AVATAR_ALLOWED_HOSTS=cdn-avatars.huggingface.co,huggingface.co,avatars.githubusercontent.com,openrouter.ai
# 回退抓取允许跟随的重定向跳数（每跳都重新校验白名单），超过返回 502
AVATAR_MAX_REDIRECTS=3

