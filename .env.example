HF_TOKEN=${YOUR_HF_TOKEN_HERE}
PROVIDERS=meta-llama,google,microsoft,openai,01-ai,deepseek-ai,Qwen,mistralai,baichuan-inc,zai-org,tencent
PROVIDERS_OPENROUTER=google,openai,anthropic
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/silicon_river
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
HF_DAILY_FETCH_LIMIT=200
OPENROUTER_DAILY_FETCH_LIMIT=300
VITE_API_BASE=${YOUR_BACKEND_API_URL_HERE}

# AI分析服务配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# 可选配置
HTTP_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2
LOG_LEVEL=INFO
# 单次分析模型上限
ANALYSIS_LIMIT_PER_PROVIDER=500

# ========== Brave Search API 配置 ==========
# Brave Search API 密钥（从 https://api.search.brave.com 获取）
BRAVE_SEARCH_API_KEY=
# 是否启用 Brave Search 联网查询（默认启用）
ENABLE_BRAVE_SEARCH=true
# Brave Search 请求超时时间（秒，默认 10）
BRAVE_SEARCH_TIMEOUT=10
# Brave Search 最大重试次数（默认 3）
BRAVE_SEARCH_MAX_RETRIES=3

# ========== MCP 数据源配置 ==========
# 启用 MCP 网络搜索功能
ENABLE_MCP_SEARCH=true
# 启用 MCP ArXiv 论文搜索功能
ENABLE_MCP_ARXIV=false

# ========== 异步分析配置 ==========
# 最大并发分析数量（默认 5）
MAX_CONCURRENT_ANALYSIS=5
# 单个模型分析超时时间（秒，默认 30）
ANALYSIS_TIMEOUT_SECONDS=30


