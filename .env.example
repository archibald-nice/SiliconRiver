# ============================================================
# Silicon River 环境变量模板
# 复制为 .env 后按下面注释填写：cp .env.example .env
# ============================================================

# ---------- 数据库（必填）----------
# Supabase 控制台 → Project Settings → Database → Connection string → Session pooler
# 用 5432 端口的 Session Pooler（支持预编译语句）；务必带 ?sslmode=require
# 密码中的特殊字符需要 URL 编码，例如 @ 写成 %40
DATABASE_URL=postgresql://postgres.你的项目ID:你的密码@aws-0-区域代码.pooler.supabase.com:5432/postgres?sslmode=require

# 数据库连接超时（秒）：库不可达时快速失败，不让请求挂到平台超时
DB_CONNECT_TIMEOUT=10

# ---------- 数据库连接池 ----------
# 进程级连接池，避免每个请求都重走 TCP + TLS + 认证。
# min_size=0：冷启动不抢连接，空闲时也不占 Supabase 的连接配额。
# max_size 压得小是刻意的：Supabase 免费层连接数有限，而 serverless 实例会横向
# 放大，池开大反而更容易打满上游配额。
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=4
# 空闲超过这么多秒就还给上游（Supabase 会掐掉长期空闲的连接）
DB_POOL_MAX_IDLE=300
# 池里无可用连接时最多等这么久，超时抛 PoolTimeout 而不是一直挂着
DB_POOL_TIMEOUT=10

# ---------- CORS ----------
# 生产是 Vercel Services 同域部署，前端走相对路径 /api/*，不产生跨域请求，
# 所以默认只放行本地开发地址即可。分域部署时把前端域名加进来（逗号分隔）。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据源 ----------
# 需要抓取的 Hugging Face 组织，逗号分隔
PROVIDERS=meta-llama,google,microsoft,openai,01-ai,deepseek-ai,Qwen,mistralai,baichuan-inc,zai-org,tencent
# OpenRouter 同步时包含的厂商
PROVIDERS_OPENROUTER=google,openai,anthropic
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
# Hugging Face 令牌（可选，不填也能抓取，只是速率受限）
HF_TOKEN=
# 增量抓取的安全上限
HF_DAILY_FETCH_LIMIT=200
OPENROUTER_DAILY_FETCH_LIMIT=300

# ---------- 前端访问后端的基址 ----------
# 部署到 Vercel（前后端同域，Services 模式）时留空：
# 留空后前端用相对路径 /api/xxx，由 Vercel 转发到后端 service
# 只有当前后端分域部署时才填后端地址，例如 http://localhost:8000
VITE_API_BASE=

# ---------- AI 分析（可选）----------
# 不填则跳过 AI 分析步骤，只导入模型基础数据（不影响前端展示）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---------- Brave Search（可选）----------
BRAVE_SEARCH_API_KEY=
# 没配 API Key 时建议改成 false，避免每次都发无效请求
ENABLE_BRAVE_SEARCH=false
BRAVE_SEARCH_TIMEOUT=10
BRAVE_SEARCH_MAX_RETRIES=3

# ---------- 抓取与分析行为 ----------
HTTP_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=2
LOG_LEVEL=INFO
ANALYSIS_LIMIT_PER_PROVIDER=500
ENABLE_MCP_SEARCH=true
ENABLE_MCP_ARXIV=false
MAX_CONCURRENT_ANALYSIS=5
ANALYSIS_TIMEOUT_SECONDS=30
